# Copy this file to .env.local for local Firebase emulator development.
# These demo values do not identify or authorize a production Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-championcreator.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-championcreator
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Optional Firebase Web config values.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set the reCAPTCHA Enterprise site key after App Check is registered.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Emulator connections are honored only by Vite development builds.
VITE_FIREBASE_USE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
