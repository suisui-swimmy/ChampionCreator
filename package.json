{
  "name": "championcreator",
  "version": "0.21.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "generate:battle-options": "node scripts/generate-battle-options.mjs",
    "generate:localization-seed": "node scripts/generate-localization-seed.mjs",
    "generate:move-hit-counts": "node scripts/add-move-hit-counts.mjs",
    "generate:pokemon-abilities": "node scripts/generate-pokemon-abilities.mjs",
    "generate:champions-usage": "node scripts/generate-champions-usage.mjs",
    "validate:artwork-assets": "node scripts/validate-artwork-assets.mjs",
    "validate:localization": "node scripts/validate-localization.mjs",
    "validate:pokemon-abilities": "node scripts/validate-pokemon-abilities.mjs",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-championcreator --only auth,firestore",
    "test:rules:vitest": "vitest run --config vitest.rules.config.ts --configLoader runner",
    "test:rules": "firebase emulators:exec --project demo-championcreator --only firestore \"npm run test:rules:vitest\"",
    "check": "npm run validate:localization && npm run validate:pokemon-abilities && npm run validate:artwork-assets && npm test && npm run test:rules && npm run build",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@smogon/calc": "file:vendor/smogon-calc-0.11.0-49d4d86.tgz",
    "firebase": "^12.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.28.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
